e complete investigative dashboard for a suspect\",\n        \"operationId\": \"getSuspectDashboard\",\n        \"parameters\": [\n          {\n            \"name\": \"id\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": { \"type\": \"string\" }\n          }\n        ],\n        \"responses\": {\n          \"200\": { \"description\": \"Full investigative summary (Logs, Location, Financial, OSINT)\" }\n        }\n      }\n    },\n    \"/api/police/intelligence\": {\n      \"get\": {\n        \"summary\": \"Fetch real-time OSINT news intelligence\",\n        \"operationId\": \"getIntelligence\",\n        \"responses\": {\n          \"200\": { \"description\": \"Latest intelligence reports\" }\n        }\n      }\n    },\n    \"/api/police/cases/public\": {\n      \"get\": {\n        \"summary\": \"Retrieve matches from public court and FIR registries\",\n        \"operationId\": \"getPublicCases\",\n        \"responses\": {\n          \"200\": { \"description\": \"Public case matches\" }\n        }\n      }\n    },\n    \"/api/police/investigation/simulate\": {\n      \"post\": {\n        \"summary\": \"Simulate data collection for an investigation (Test Mode)\",\n        \"operationId\": \"simulateInvestigation\",\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"suspectId\": { \"type\": \"string\" }\n                },\n                \"required\": [\"suspectId\"]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": { \"description\": \"Dashboard populated with simulated evidence\" }\n        }\n      }\n    },\n    \"/api/police/investigation/seal\": {\n      \"post\": {\n        \"summary\": \"Seal an investigation and securely dispose of active session data\",\n        \"operationId\": \"sealInvestigation\",\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"suspectId\": { \"type\": \"string\" }\n                },\n                \"required\": [\"suspectId\"]\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": { \"description\": \"Investigation sealed and archived\" }\n        }\n      }\n    },\n    \"/api/police/audit-logs\": {\n      \"get\": {\n        \"summary\": \"Retrieve master audit logs for the Hub\",\n        \"operationId\": \"getAuditLogs\",\n        \"responses\": {\n          \"200\": { \"description\": \"Full audit trail\" }\n        }\n      }\n    },\n    \"/api/ingest\": {\n      \"post\": {\n        \"summary\": \"Ingest investigative assets into the Police Data Box\",\n        \"operationId\": \"ingestAsset\",\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"multipart/form-data\": {\n              \"schema\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"file\": { \"type\": \"string\", \"format\": \"binary\" },\n                  \"useDataBox\": { \"type\": \"string\", \"default\": \"true\" },\n                  \"suspectId\": { \"type\": \"string\" }\n                }\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": { \"description\": \"Asset securely transferred to Data Box\" }\n        }\n      }\n    }\n  },\n  \"components\": {\n    \"securitySchemes\": {\n      \"bearerAuth\": {\n        \"type\": \"http\",\n        \"scheme\": \"bearer\",\n        \"bearerFormat\": \"JWT\"\n      }\n    }\n  },\n  \"security\": [\n    {\n      \"bearerAuth\": []\n    }\n  ]\n}\n"}}
