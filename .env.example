PORT=3000
DATABASE_PATH=.data/streamvista.sqlite
APP_ORIGIN=http://localhost:3000
SEED_OWNER_EMAIL=founder@example.com
SEED_OWNER_PASSWORD=replace-with-a-long-random-password

# StreamVista AI server runtime (never expose this in VITE_* variables)
GEMINI_API_KEY=replace-with-gemini-api-key
# Optional model override. Default in api/chat.mjs: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
