# Razorpay (server-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI providers (server-only)
GEMINI_API_KEY=

# Product analytics (server-side ingestion)
