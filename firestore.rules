rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Role-based helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      // Profiles are stored in the "users" collection, not "roles"
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isPlatformAdmin() {
      let role = getUserRole();
      return role == 'platform_owner' || role == 'founder' || role == 'super_admin';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isPlatformAdmin());
      allow write: if isAuthenticated() && isPlatformAdmin();
    }
    
    // Roles Collection
    match /roles/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isPlatformAdmin();
    }

    // Profiles Collection
    match /profiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isPlatformAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isPlatformAdmin());
    }

    // Titles Collection
    match /titles/{titleId} {
      allow read: if isAuthenticated(); 
      allow create: if isAuthenticated() && getUserRole() in ['creator_partner', 'admin', 'super_admin'];
      allow update: if isAuthenticated() && (
        isPlatformAdmin() || 
        (
          getUserRole() == 'creator_partner' && 
          resource.data.creatorOwnerId == request.auth.uid &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'qcStatus', 'legalStatus', 'approvalStatus']))
        ) ||
        (
          getUserRole() == 'qc_staff' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qcStatus', 'updatedAt'])
        ) ||
        (
          getUserRole() == 'legal_staff' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['legalStatus', 'status', 'approvalStatus', 'updatedAt'])
        )
      );
      allow delete: if isAuthenticated() && isPlatformAdmin();
    }

    // Finance Data (Payments, Payouts)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (isPlatformAdmin() || getUserRole() == 'finance');
      allow write: if false; // Server-side logic only
    }

    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        isPlatformAdmin() || 
        getUserRole() == 'finance' || 
        (getUserRole() == 'creator_partner' && resource.data.creatorOwnerId == request.auth.uid)
      );
      allow write: if false; // Server-side logic only
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && isPlatformAdmin();
      allow write: if false; // Server-side logic only
    }

    // Drafts Collection
    match /drafts/{draftId} {
      allow read: if isAuthenticated() && (resource.data.creatorOwnerId == request.auth.uid || isPlatformAdmin());
      allow create: if isAuthenticated() && getUserRole() == 'creator_partner' && request.resource.data.creatorOwnerId == request.auth.uid;
      allow update: if isAuthenticated() && getUserRole() == 'creator_partner' && resource.data.creatorOwnerId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.creatorOwnerId == request.auth.uid || isPlatformAdmin());
    }

    // Wallets Collection
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (walletId == request.auth.uid || isPlatformAdmin() || getUserRole() == 'finance');
      allow write: if false; // Server-side logic only
    }

    // Ledgers Collection
    match /ledgers/{ledgerId} {
      allow read: if isAuthenticated() && (resource.data.creatorId == request.auth.uid || isPlatformAdmin() || getUserRole() == 'finance');
      allow write: if false; // Server-side logic only
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // Server-side logic only
    }
  }
}
