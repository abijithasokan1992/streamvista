    "@opentelemetry/sdk-node": "^0.221.0",
    "@supabase/supabase-js": "^2.56.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.13.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.23.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "oci-common": "^2.136.0",
    "oci-objectstorage": "^2.136.0",
    "oracledb": "^7.0.2",
    "qrcode-generator": "^2.0.4",
    "razorpay": "^2.9.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "vite": "^8.1.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.1.0",
    "@types/oracledb": "^7.0.2",
    "@types/xml2js": "^0.4.14",
    "esbuild": "^0.28.2",
