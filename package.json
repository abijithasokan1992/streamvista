{
  "scripts": {
    "dev:web": "vite",
    "dev:api": "ts-node-dev --respawn --transpile-only --project apps/auto-api/tsconfig.json apps/auto-api/src/server.ts",
    "dev": "npm run dev:web & npm run dev:api",
    "build:web": "vite build",
    "build:api": "tsc -p apps/auto-api/tsconfig.json",
    "build": "npm run build:web && npm run build:api",
    "start": "node apps/auto-api/dist/server.js",
    "typecheck": "tsc -p apps/auto-api/tsconfig.json --noEmit && tsc -p apps/auto-web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
