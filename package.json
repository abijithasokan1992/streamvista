{
  "scripts": {
    "dev:web": "vite",
    "dev:api": "ts-node-dev --respawn --transpile-only --project apps/auto-api/tsconfig.json apps/auto-api/src/server.ts",
    "dev": "npm run dev:web & npm run dev:api",
    "lint": "eslint --config ./eslint.config.mjs \"apps/auto-api/src/**/*.{ts,tsx}\" \"apps/auto-api/tests/**/*.{js,ts,tsx}\" \"apps/web/app/**/*.{ts,tsx}\"",
    "build:web": "vite build",
    "build:api": "tsc -p apps/auto-api/tsconfig.json",
    "build": "npm run build:web && npm run build:api",
    "start": "node apps/auto-api/dist/server.js",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "typecheck:api": "tsc -p apps/auto-api/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test:unit": "npm run build:api && node --test apps/auto-api/tests/unit/**/*.test.js",
    "test:integration": "npm run build:api && node --test apps/auto-api/tests/integration/**/*.test.js",
    "test": "npm run test:unit && npm run test:integration"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@supabase/supabase-js": "^2.56.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "firebase": "^12.13.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.23.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "oci-common": "^2.136.0",
    "oci-objectstorage": "^2.136.0",
    "oracledb": "^7.0.1",
    "qrcode-generator": "^2.0.4",
    "razorpay": "^2.9.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "vite": "^8.1.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^2.1.0",
    "@types/oracledb": "^7.0.2",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "esbuild": "^0.28.2",
    "globals": "^16.4.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript-eslint": "^8.43.0",
    "typescript": "^5.7.3"
  }
}
