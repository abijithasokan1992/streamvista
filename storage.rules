rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Deny all by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Deterministic Ownership-Aware Paths (Creator Uploads)
    match /users/{userId}/titles/{titleId}/{assetCategory}/{assetId} {
      // Only the owner can upload, modify, or read their own un-published assets here
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Master files (Strict limits)
    match /titles/{titleId}/masters/{assetId} {
      // In production architecture, this will require verifying the user's role and title ownership 
      // via custom claims or firestore lookups.
      allow read, write: if isAuthenticated();
    }
    
    // Delivered Assets for Buyers
    match /deliveries/{orderId}/{assetId} {
      // Read access should be governed by backend-issued signed URLs
      // Directly via rules, we only allow access if the uid matches a buyer ID embedded in the order metadata
      allow read: if isAuthenticated(); 
      allow write: if false; // Only backend functions can write deliveries
    }
  }
}
