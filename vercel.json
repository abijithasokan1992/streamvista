{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/((?!health$).*)",
      "destination": "https://command.streamvista.in/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
